<article class="character-card" data-actor-id="{{id}}">
  <header class="character-header">
    <img class="character-avatar" src="{{img}}" alt="{{name}}" data-action="openSheet" title="{{localize 'NIMBLE_DM_HELPER.openSheet'}}">
    <div class="character-info">
      <h3 class="character-name">{{name}}</h3>
      <span class="character-class">{{className}} {{level}}</span>
    </div>
    {{#if conditions.length}}
      <div class="conditions">
        {{#each conditions}}
          <img src="{{icon}}" title="{{name}}" class="condition-icon">
        {{/each}}
      </div>
    {{/if}}
  </header>

  <div class="character-resources">
    <!-- HP Bar -->
    <div class="resource-bar-container" data-resource="hp">
      <div class="resource-header">
        <span class="resource-label">HP</span>
        <span class="resource-value" data-resource="hp">{{resources.hp.value}}/{{resources.hp.max}}</span>
      </div>
      <div class="resource-bar-wrapper">
        <div class="resource-bar hp-bar" style="width: {{percent resources.hp.value resources.hp.max}}%; background-color: {{resources.hp.color}};"></div>
        {{#if resources.hp.temp}}
          <div class="temp-hp-indicator">+{{resources.hp.temp}}</div>
        {{/if}}
      </div>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="hp" data-delta="-5">-5</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="hp" data-delta="-1">-1</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="hp" data-delta="1">+1</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="hp" data-delta="5">+5</button>
      </div>
    </div>

    <!-- Temp HP -->
    {{#if resources.hp.temp}}
    <div class="resource-inline temp-hp">
      <span class="resource-label">Temp HP</span>
      <span class="resource-value">{{resources.hp.temp}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="tempHp" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="tempHp" data-delta="1">+</button>
      </div>
    </div>
    {{/if}}

    <!-- Wounds -->
    <div class="wound-tracker">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.wounds"}}</span>
      <div class="wound-boxes" data-current="{{resources.wounds.value}}" data-max="{{resources.wounds.max}}">
      </div>
      <span class="wound-count">{{resources.wounds.value}}/{{resources.wounds.max}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="wounds" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="wounds" data-delta="1">+</button>
      </div>
    </div>

    <!-- Mana (if applicable) -->
    {{#if resources.mana.max}}
    <div class="resource-bar-container mana-resource" data-resource="mana">
      <div class="resource-header">
        <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.mana"}}</span>
        {{#if resources.mana.formula}}
          <span class="resource-formula" title="{{resources.mana.formula}}"><i class="fas fa-calculator"></i></span>
        {{/if}}
        <span class="resource-value" data-resource="mana">{{resources.mana.value}}/{{resources.mana.max}}</span>
      </div>
      <div class="resource-bar-wrapper">
        <div class="resource-bar mana-bar" style="width: {{percent resources.mana.value resources.mana.max}}%; background-color: {{resources.mana.color}};"></div>
      </div>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="mana" data-delta="-1">-1</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="mana" data-delta="1">+1</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="mana" data-delta="5">+5</button>
      </div>
    </div>
    {{/if}}

    <!-- Dice Pools (dynamic based on canStoreDice) -->
    {{#each dicePools}}
    <div class="dice-pool {{key}}-dice" data-resource="{{key}}" data-die-size="{{dieSize}}" data-max="{{max}}" style="border-left: 3px solid {{color}};">
      <div class="dice-header">
        <span class="resource-label">{{localize label}}</span>
        <span class="dice-info">
          <span class="die-size-badge" style="background: {{color}};">{{dieSize}}</span>
        </span>
      </div>
      <div class="dice-display" data-color="{{color}}">
        {{!-- Les slots de dés sont générés en JavaScript --}}
      </div>
    </div>
    {{/each}}

    {{!-- Single Value Resources (canStoreValue) --}}
    {{#each valueResources}}
    <div class="value-resource {{key}}-value" data-resource="{{key}}" style="border-left: 3px solid {{color}};">
      <div class="value-header">
        <span class="resource-label">{{localize label}}</span>
        <span class="value-info">
          <span class="die-size-badge" style="background: {{color}};">{{dieSize}}</span>
          <span class="value-max">max: {{max}}</span>
        </span>
      </div>
      <div class="value-display">
        <span class="single-value" data-action="editSingleValue" data-value="{{storedValue}}" style="background: {{#if storedValue}}{{color}}{{else}}rgba(0,0,0,0.3){{/if}};">{{storedValue}}</span>
      </div>
    </div>
    {{/each}}

    <!-- Rage Active Status (Berserker) -->
    {{#if resources.rageActive}}
      <span class="status-badge rage">RAGE</span>
    {{/if}}

    <!-- Lay on Hands (Oathsworn) -->
    {{#if resources.layOnHands}}
    <div class="resource-bar-container" data-resource="layOnHands">
      <div class="resource-header">
        <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.layOnHands"}}</span>
        <span class="resource-value">{{resources.layOnHands.value}}/{{resources.layOnHands.max}}</span>
      </div>
      <div class="resource-bar-wrapper">
        <div class="resource-bar" style="width: {{percent resources.layOnHands.value resources.layOnHands.max}}%; background-color: {{resources.layOnHands.color}};"></div>
      </div>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="layOnHands" data-delta="-5">-5</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="layOnHands" data-delta="-1">-1</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="layOnHands" data-delta="1">+1</button>
      </div>
    </div>
    {{/if}}

    <!-- Coordinated Strike (Commander) -->
    {{#if resources.coordinatedStrike}}
    <div class="resource-inline">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.coordinatedStrike"}}</span>
      <span class="resource-value">{{resources.coordinatedStrike.value}}/{{resources.coordinatedStrike.max}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="coordinatedStrike" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="coordinatedStrike" data-delta="1">+</button>
      </div>
    </div>
    {{/if}}

    <!-- Thrill of the Hunt (Hunter) -->
    {{#if resources.thrillOfHunt}}
    <div class="resource-inline">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.thrillOfHunt"}}</span>
      <span class="resource-value">{{resources.thrillOfHunt.value}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="thrillOfHunt" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="thrillOfHunt" data-delta="1">+</button>
      </div>
    </div>
    {{#if resources.huntersMark}}
    <div class="mark-indicator">
      <i class="fas fa-crosshairs"></i> {{resources.huntersMark}}
    </div>
    {{/if}}
    {{/if}}

    <!-- Burst of Speed (Zephyr) -->
    {{#if resources.burstOfSpeed}}
    <div class="resource-inline">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.burstOfSpeed"}}</span>
      <span class="resource-value">{{resources.burstOfSpeed.value}}/{{resources.burstOfSpeed.max}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="burstOfSpeed" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="burstOfSpeed" data-delta="1">+</button>
      </div>
    </div>
    {{/if}}

    <!-- Beastshift (Stormshifter) -->
    {{#if resources.beastshift}}
    <div class="resource-inline">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.beastshift"}}</span>
      <span class="resource-value">{{resources.beastshift.value}}/{{resources.beastshift.max}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="beastshift" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="beastshift" data-delta="1">+</button>
      </div>
    </div>
    {{/if}}

    <!-- Inspiration (Songweaver) -->
    {{#if resources.inspiration}}
    <div class="resource-inline">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.inspiration"}}</span>
      <span class="resource-value">{{resources.inspiration.value}}/{{resources.inspiration.max}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="inspiration" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="inspiration" data-delta="1">+</button>
      </div>
    </div>
    {{/if}}

    <!-- Pilfered Power (Shadowmancer) -->
    {{#if resources.pilferedPower}}
    <div class="resource-inline">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.pilferedPower"}}</span>
      <span class="resource-value">{{resources.pilferedPower.value}}/{{resources.pilferedPower.max}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="pilferedPower" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="pilferedPower" data-delta="1">+</button>
      </div>
    </div>
    {{/if}}

    <!-- Shadow Minions (Shadowmancer) -->
    {{#if resources.shadowMinions}}
    <div class="resource-inline shadow-minions">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.shadowMinions"}}</span>
      <span class="resource-value">{{resources.shadowMinions.value}}/{{resources.shadowMinions.max}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="shadowMinions" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="shadowMinions" data-delta="1">+</button>
      </div>
    </div>
    {{/if}}

    <!-- Searing Light (Shepherd) -->
    {{#if resources.searingLight}}
    <div class="resource-inline">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.searingLight"}}</span>
      <span class="resource-value">{{resources.searingLight.value}}/{{resources.searingLight.max}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="searingLight" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="searingLight" data-delta="1">+</button>
      </div>
    </div>
    {{/if}}

    <!-- Sneak Attack (The Cheat) -->
    {{#if resources.sneakAttack}}
    <div class="resource-inline sneak-attack">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.sneakAttack"}}</span>
      <span class="die-size">{{resources.sneakAttack.dieSize}}</span>
      {{#if resources.sneakAttack.available}}
        <span class="status-badge available">READY</span>
      {{else}}
        <span class="status-badge used">USED</span>
      {{/if}}
    </div>
    {{/if}}

    <!-- Cheat Uses (The Cheat) -->
    {{#if resources.cheatUses}}
    <div class="resource-inline cheat-uses">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.cheatUses"}}</span>
      {{#if resources.cheatUses.moveOrHide}}
        <span class="status-badge available">Move/Hide</span>
      {{else}}
        <span class="status-badge used">Move/Hide</span>
      {{/if}}
      <span class="resource-value">Daily: {{resources.cheatUses.daily.value}}/{{resources.cheatUses.daily.max}}</span>
    </div>
    {{/if}}
  </div>

  <!-- Abilities Section -->
  {{#if @root.settings.showAbilities}}
  {{#if abilities.length}}
  <div class="ability-section">
    <div class="ability-section-header">{{localize "NIMBLE_DM_HELPER.abilities"}}</div>
    <div class="ability-list">
      {{#each abilities}}
        <span class="ability-item {{#unless available}}unavailable{{/unless}}" data-description="{{description}}" title="{{description}}">
          {{name}}
        </span>
      {{/each}}
    </div>
  </div>
  {{/if}}
  {{/if}}
</article>
