<article class="character-card" data-actor-id="{{id}}">
  <header class="character-header">
    <img class="character-avatar" src="{{img}}" alt="{{name}}" data-action="openSheet" title="{{localize 'NIMBLE_DM_HELPER.openSheet'}}">
    <div class="character-info">
      <h3 class="character-name">{{name}}</h3>
      <span class="character-class">{{className}} {{level}}</span>
    </div>
    {{#if conditions.length}}
      <div class="conditions">
        {{#each conditions}}
          <img src="{{icon}}" title="{{name}}" class="condition-icon">
        {{/each}}
      </div>
    {{/if}}
  </header>

  <div class="character-resources">
    <!-- HP Bar -->
    <div class="resource-bar-container {{#if @root.settings.mergedBars}}merged-bar{{/if}}" data-resource="hp">
      {{#unless @root.settings.mergedBars}}
      <div class="resource-header">
        <span class="resource-label">HP</span>
        <span class="resource-value" data-resource="hp">{{resources.hp.value}}/{{resources.hp.max}}</span>
      </div>
      {{/unless}}
      <div class="resource-bar-wrapper">
        <div class="resource-bar hp-bar" style="width: {{percent resources.hp.value resources.hp.max}}%; background-color: {{resources.hp.color}};"></div>
        {{#if @root.settings.mergedBars}}
        <div class="merged-bar-overlay">
          <span class="resource-label">HP</span>
          <span class="merged-bar-values">
            {{#if resources.hp.temp}}<span class="merged-temp-hp">+{{resources.hp.temp}}</span>{{/if}}
            <span class="resource-value" data-resource="hp">{{resources.hp.value}}/{{resources.hp.max}}</span>
          </span>
        </div>
        {{else}}
        {{#if resources.hp.temp}}
          <div class="temp-hp-indicator">+{{resources.hp.temp}}</div>
        {{/if}}
        {{/if}}
      </div>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="hp" data-delta="-5">-5</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="hp" data-delta="-1">-1</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="hp" data-delta="1">+1</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="hp" data-delta="5">+5</button>
      </div>
    </div>

    <!-- Temp HP -->
    {{#if resources.hp.temp}}
    <div class="resource-inline temp-hp">
      <span class="resource-label">Temp HP</span>
      <span class="resource-value">{{resources.hp.temp}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="tempHp" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="tempHp" data-delta="1">+</button>
      </div>
    </div>
    {{/if}}

    <!-- Wounds -->
    {{#if showWounds}}
    <div class="wound-tracker">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.wounds"}}</span>
      <div class="wound-boxes" data-current="{{resources.wounds.value}}" data-max="{{resources.wounds.max}}">
      </div>
      <span class="wound-count">{{resources.wounds.value}}/{{resources.wounds.max}}</span>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="wounds" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="wounds" data-delta="1">+</button>
      </div>
    </div>
    {{/if}}

    <!-- Mana (if applicable) -->
    {{#if resources.mana.max}}
    <div class="resource-bar-container mana-resource {{#if @root.settings.mergedBars}}merged-bar{{/if}}" data-resource="mana">
      {{#unless @root.settings.mergedBars}}
      <div class="resource-header">
        <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.mana"}}</span>
        {{#if resources.mana.formula}}
          <span class="resource-formula" title="{{resources.mana.formula}}"><i class="fas fa-calculator"></i></span>
        {{/if}}
        <span class="resource-value" data-resource="mana">{{resources.mana.value}}/{{resources.mana.max}}</span>
      </div>
      {{/unless}}
      <div class="resource-bar-wrapper">
        <div class="resource-bar mana-bar" style="width: {{percent resources.mana.value resources.mana.max}}%; background: {{resources.mana.color}};"></div>
        {{#if @root.settings.mergedBars}}
        <div class="merged-bar-overlay">
          <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.mana"}}</span>
          <span class="resource-value" data-resource="mana">{{resources.mana.value}}/{{resources.mana.max}}</span>
        </div>
        {{/if}}
      </div>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="mana" data-delta="-1">-1</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="mana" data-delta="1">+1</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="mana" data-delta="5">+5</button>
      </div>
    </div>
    {{/if}}

    <!-- Dice Pools (dynamic based on canStoreDice) -->
    {{#each dicePools}}
    <div class="dice-pool {{key}}-dice" data-resource="{{key}}" data-die-size="{{dieSize}}" data-max="{{max}}" style="border-left: 3px solid {{color}};">
      <div class="dice-header">
        <span class="resource-label">{{localize label}}</span>
        <span class="dice-info">
          <span class="die-size-badge" style="background: {{color}};">{{dieSize}}</span>
          {{#if @root.settings.showDicePoolMax}}
          <span class="value-max">max: {{max}}</span>
          {{/if}}
        </span>
      </div>
      <div class="dice-display" data-color="{{color}}">
        {{!-- Les slots de dés sont générés en JavaScript --}}
      </div>
    </div>
    {{/each}}

    {{!-- Single Value Resources (canStoreValue) --}}
    {{#each valueResources}}
    <div class="value-resource {{key}}-value" data-resource="{{key}}" data-die-size="{{dieSize}}" style="border-left: 3px solid {{color}};">
      <div class="value-header">
        <span class="resource-label">{{localize label}}</span>
        <span class="value-info">
          <span class="die-size-badge" style="background: {{color}};">{{dieSize}}</span>
          <span class="value-max">max: {{max}}</span>
        </span>
      </div>
      <div class="value-display">
        <span class="die-slot">
          <span class="single-value" data-action="editSingleValue" data-value="{{storedValue}}" style="--die-color: {{color}}; background: {{#if storedValue}}{{color}}{{else}}rgba(0,0,0,0.3){{/if}};">{{storedValue}}</span>
          {{#if storedValue}}
          <button class="die-delete" type="button" data-action="clearSingleValue" data-resource="{{key}}" title="{{localize 'NIMBLE_DM_HELPER.clearDice'}}"><i class="fas fa-times"></i></button>
          {{/if}}
        </span>
      </div>
    </div>
    {{/each}}

    <!-- Rage Active Status (Berserker) NOT USED -->
    {{#if resources.rageActive}}
      <span class="status-badge rage">RAGE</span>
    {{/if}}

    {{!-- Bar Resources (generic loop - ex: Lay on Hands) --}}
    {{#each barResources}}
    <div class="resource-bar-container" data-resource="{{key}}">
      <div class="resource-header">
        <span class="resource-label">{{localize label}}</span>
        <span class="resource-value">{{value}}/{{max}}</span>
      </div>
      <div class="resource-bar-wrapper">
        <div class="resource-bar" style="width: {{percent value max}}%; background-color: {{color}};"></div>
      </div>
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="{{key}}" data-delta="-5">-5</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="{{key}}" data-delta="-1">-1</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="{{key}}" data-delta="1">+1</button>
      </div>
    </div>
    {{/each}}

    {{!-- Inline Resources (generic loop) --}}
    {{#each inlineResources}}
    <div class="resource-inline">
      <span class="resource-label">{{localize label}}</span>
      {{#if max}}
      <span class="resource-value">{{value}}/{{max}}</span>
      {{else}}
      <span class="resource-value">{{value}}</span>
      {{/if}}
      <div class="resource-controls">
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="{{key}}" data-delta="-1">-</button>
        <button class="resource-adjust" type="button" data-action="adjustResource" data-resource="{{key}}" data-delta="1">+</button>
      </div>
    </div>
    {{/each}}

    <!-- Hunter's Mark (Hunter) -->
    {{#if resources.huntersMark}}
    <div class="mark-indicator">
      <i class="fas fa-crosshairs"></i> {{resources.huntersMark}}
    </div>
    {{/if}}

    <!-- Sneak Attack (The Cheat) NOT USED -->
    {{#if resources.sneakAttack}}
    <div class="resource-inline sneak-attack">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.sneakAttack"}}</span>
      <span class="die-size">{{resources.sneakAttack.dieSize}}</span>
      {{#if resources.sneakAttack.available}}
        <span class="status-badge available">READY</span>
      {{else}}
        <span class="status-badge used">USED</span>
      {{/if}}
    </div>
    {{/if}}

    <!-- Cheat Uses (The Cheat) NOT USED -->
    {{#if resources.cheatUses}}
    <div class="resource-inline cheat-uses">
      <span class="resource-label">{{localize "NIMBLE_DM_HELPER.resources.cheatUses"}}</span>
      {{#if resources.cheatUses.moveOrHide}}
        <span class="status-badge available">Move/Hide</span>
      {{else}}
        <span class="status-badge used">Move/Hide</span>
      {{/if}}
      <span class="resource-value">Daily: {{resources.cheatUses.daily.value}}/{{resources.cheatUses.daily.max}}</span>
    </div>
    {{/if}}
  </div>

  <!-- Abilities Section -->
  {{#if @root.settings.showAbilities}}
  {{#if abilities.length}}
  <div class="ability-section">
    <div class="ability-section-header">{{localize "NIMBLE_DM_HELPER.abilities"}}</div>
    <div class="ability-list">
      {{#each abilities}}
        <span class="ability-item {{#unless available}}unavailable{{/unless}}" data-description="{{description}}">
          {{name}}
          {{#if @root.settings.showDeleteAbility}}
          <button class="ability-delete" type="button" data-action="deleteAbility" data-ability-id="{{id}}" title="{{localize 'NIMBLE_DM_HELPER.deleteAbility'}}"><i class="fas fa-trash-alt"></i></button>
          {{/if}}
        </span>
      {{/each}}
    </div>
  </div>
  {{/if}}
  {{/if}}
</article>
